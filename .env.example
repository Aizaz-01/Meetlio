# Meetlio Production & Development Environment Variables

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meetlio?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session Security & Hashing Secret
SESSION_SECRET="meetlio_super_secret_session_key_min_32_characters"

# OAuth Integration - Google Workspace / Calendar
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# OAuth Integration - Microsoft Outlook / Office 365
MICROSOFT_CLIENT_ID="your_microsoft_client_id_here"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret_here"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Resend Email Delivery Engine
RESEND_API_KEY="re_your_resend_api_key"

# Encryption Secret for Secure Token Hashing (32-byte string)
ENCRYPTION_KEY="meetlio_secure_aes_256_encryption_key_32bytes"
